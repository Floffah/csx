{
    "name": "csx-workspace",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "examples/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "build:ts": "turbo run build",
        "build:rust": "cargo build --workspace",
        "typecheck": "turbo run typecheck:ts",
        "typecheck:ts": "tsc --noEmit",
        "test": "turbo run test test:rust",
        "test:rust": "cargo test --workspace",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "check": "bun run format:check && turbo run typecheck:ts check:rust",
        "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "@types/bun": "^1.4.4",
        "postcss": "^8.5.32",
        "prettier": "3.9.10",
        "rolldown-plugin-wasm": "^0.3.2",
        "tsdown": "^0.23.7",
        "turbo": "^2.11.10",
        "typescript": "^7.0.2",
        "vite": "^8.3.7"
    },
    "packageManager": "bun@1.4.4"
}
